# Copy to .env (gitignored). Names only — values live in 1Password.
# Inject at runtime: op run --env-file=.env -- <cmd>   OR   op inject -i .env.tpl -o .env
# Reference style:  EXAMPLE_TOKEN="op://<Vault>/<Item>/<field>"   (quote it: vault names have spaces)
#   CWP: op://CWP Tech/...   Darkwell: op://Darkwell/...   personal: op://Personal Dev/... (pass --account my.1password.com)
EXAMPLE_API_TOKEN=
