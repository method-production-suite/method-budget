{
  "productName": "Method Budget",
  "identifier": "com.methodbudget.desktop",
  "version": "0.1.0",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Method Budget",
        "width": 1280,
        "height": 820,
        "minWidth": 880,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true,
      "capabilities": [
        "main",
        "tools",
        "setup"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Method Budget contributors",
    "copyright": "Copyright (c) 2026 Method Budget contributors",
    "category": "Productivity",
    "shortDescription": "Film and TV budgeting",
    "longDescription": "An open-source, clean-room film and TV budgeting app. Budgets are plain .mthd files on your disk.",
    "license": "MIT OR Apache-2.0",
    "homepage": "https://methodbudget.com",
    "resources": {
      "../../packs/": "packs/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "mthd"
        ],
        "name": "Method Budget",
        "description": "Method Budget",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "application/vnd.method-budget+json",
        "exportedType": {
          "identifier": "com.methodbudget.mthd",
          "conformsTo": [
            "public.json",
            "public.data"
          ]
        }
      }
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE-WITH-THE-RELEASE-PUBLIC-KEY",
      "endpoints": [
        "https://github.com/ssandweiss/method-budget/releases/latest/download/latest.json"
      ]
    }
  }
}
