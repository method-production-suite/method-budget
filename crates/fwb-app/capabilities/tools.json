{
  "identifier": "tools",
  "description": "The tools window (the tools panel popped out of the main window) may call only the commands the panel uses: the selection summary and applying items to the selected lines, the setup tables, the budget tabs (charges, credits, info, settings, baseline), a line's note and the list of notes, and get_view; and send and receive events between the two windows. No file, save, undo or window commands: it passes those keys to the main window.",
  "windows": [
    "tools"
  ],
  "permissions": [
    "allow-get-view",
    "allow-apply-summary",
    "allow-apply-to-rows",
    "allow-assign-to-rows",
    "allow-make-fringe-range",
    "allow-clear-fringe-range",
    "allow-set-fringe",
    "allow-delete-fringe",
    "allow-set-group",
    "allow-update-group",
    "allow-delete-group",
    "allow-set-set",
    "allow-delete-set",
    "allow-set-location",
    "allow-delete-location",
    "allow-set-currency",
    "allow-delete-currency",
    "allow-set-global",
    "allow-delete-global",
    "allow-set-unit",
    "allow-delete-unit",
    "allow-set-charge",
    "allow-delete-charge",
    "allow-move-charge",
    "allow-set-credit",
    "allow-delete-credit",
    "allow-move-credit",
    "allow-set-info",
    "allow-delete-info",
    "allow-set-fringe-posting",
    "allow-set-account-coding",
    "allow-set-base-currency",
    "allow-set-totals-currency",
    "allow-set-new-line-defaults",
    "allow-lock-baseline",
    "allow-clear-baseline",
    "allow-set-row-note",
    "allow-notes-list",
    "core:event:allow-listen",
    "core:event:allow-emit-to"
  ]
}
