{
  "identifier": "main",
  "description": "The main window may call the app's own budget commands, listen for the native menu's events, open the print sheet and close itself (which asks about unsaved changes), and nothing else: no file system, shell, network or dialog access from the web view (dialogs are opened by Rust).",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-get-view",
    "allow-new-budget",
    "allow-open-budget",
    "allow-save-budget",
    "allow-undo",
    "allow-redo",
    "allow-set-title",
    "allow-add-category",
    "allow-add-production-total",
    "allow-update-topsheet-row",
    "allow-delete-topsheet-row",
    "allow-add-account",
    "allow-update-account",
    "allow-delete-account",
    "allow-set-detail-field",
    "allow-set-rows-field",
    "allow-add-detail",
    "allow-delete-details",
    "allow-selection-totals",
    "allow-set-global",
    "allow-delete-global",
    "allow-set-fringe",
    "allow-delete-fringe",
    "allow-set-group",
    "allow-delete-group",
    "allow-set-unit",
    "allow-delete-unit",
    "allow-set-currency",
    "allow-delete-currency",
    "allow-set-charge",
    "allow-delete-charge",
    "allow-move-charge",
    "allow-set-credit",
    "allow-delete-credit",
    "allow-move-credit",
    "allow-set-set",
    "allow-delete-set",
    "allow-set-location",
    "allow-delete-location",
    "allow-set-info",
    "allow-delete-info",
    "allow-set-fringe-posting",
    "allow-set-account-coding",
    "allow-set-base-currency",
    "allow-set-totals-currency",
    "allow-lock-baseline",
    "allow-clear-baseline",
    "allow-set-cells",
    "allow-set-row-style",
    "allow-set-row-note",
    "allow-set-group-color",
    "allow-apply-summary",
    "allow-apply-to-rows",
    "allow-assign-to-rows",
    "allow-make-fringe-range",
    "allow-clear-fringe-range",
    "core:event:allow-listen",
    "core:webview:allow-print",
    "core:window:allow-close"
  ]
}
