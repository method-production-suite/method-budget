{
  "productName": "Film Wizard Budgeting",
  "identifier": "io.github.ssandweiss.film-wizard-budgeting",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Film Wizard Budgeting",
        "width": 1280,
        "height": 820,
        "minWidth": 880,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true,
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Sam Sandweiss",
    "copyright": "Copyright (c) 2026 Sam Sandweiss and contributors",
    "category": "Productivity",
    "shortDescription": "Film and TV budgeting",
    "longDescription": "An open-source, clean-room film and TV budgeting app. Budgets are plain .fwb files on your disk.",
    "license": "MIT OR Apache-2.0",
    "homepage": "https://github.com/ssandweiss/film-wizard-budgeting",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "fwb"
        ],
        "name": "Film Wizard Budget",
        "description": "Film Wizard Budget",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "application/vnd.film-wizard-budget+json",
        "exportedType": {
          "identifier": "io.github.ssandweiss.film-wizard-budgeting.fwb",
          "conformsTo": [
            "public.json",
            "public.data"
          ]
        }
      }
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
