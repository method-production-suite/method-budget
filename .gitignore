# Secrets: never commit
.env
.env.*
!.env.example
.mcp.json
*.pem
*.key
id_rsa*

# OS / editor
.DS_Store
.idea/
.vscode/

# Logs / scratch
*.log

# Rust
/target/

# Reference screenshots of other tools (clean-room: never commit)
/Screenshots/
/docs/research/mmb-screens.md

# Scratch budgets at the repo root (test files, personal budgets)
/*.mthd
/Test Library/

# Claude Code: only the project's skills and shared settings are versioned. Everything
# else under .claude/ stays local, above all .claude/worktrees/ (complete checkouts that
# must never be staged) and settings.local.json. The trailing /* (not .claude/ itself)
# is what lets the two ! lines re-include. docs/WEBSITE.md has the reasoning.
/.claude/*
!/.claude/skills/
!/.claude/settings.json

# Raw chart-of-accounts sources used to build templates; not committed.
/imports/
